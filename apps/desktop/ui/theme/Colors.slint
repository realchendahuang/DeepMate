// Centralized color tokens for the DeepMate desktop shell.
//
// Dark, muted control-center palette. All visual values must come from these
// tokens so pages stay visually consistent.

export global Colors {
    out property <color> bg: #0f1114;
    out property <color> panel: #171a20;
    out property <color> panel-alt: #12151a;
    out property <color> border: #262b34;
    out property <color> hover: #1e232c;
    out property <color> selection: #273750;
    out property <color> text: #e6e8eb;
    out property <color> text-dim: #98a0ab;
    out property <color> accent: #4c8dff;
    out property <color> pass: #3fb27f;
    out property <color> warn: #d9a13b;
    out property <color> fail: #e05d5d;
    out property <color> skip: #7a828c;
    out property <color> neutral: #8a93a0;
}
