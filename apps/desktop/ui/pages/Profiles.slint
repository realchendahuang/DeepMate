import { Button, ScrollView } from "std-widgets.slint";
import { Card } from "../components/Card.slint";
import { Colors } from "../theme/Colors.slint";
import { Metrics } from "../theme/Metrics.slint";
import { Typography } from "../theme/Typography.slint";

// One profile row, mirrored from the core Profile model.
export struct ProfileRow {
    id: string,
    name: string,
    description: string,
}

// Profiles page: list the harness profiles known to the adapter.
export component ProfilesPage inherits Rectangle {
    in property <[ProfileRow]> profiles: [];

    callback refresh();

    background: Colors.bg;

    VerticalLayout {
        padding: Metrics.padding;
        spacing: Metrics.spacing;

        HorizontalLayout {
            spacing: Metrics.spacing;

            Text {
                text: "Profiles";
                color: Colors.text;
                font-size: Typography.title;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Refresh";
                clicked => {
                    root.refresh();
                }
            }
        }

        sv := ScrollView {
            VerticalLayout {
                width: sv.visible-width;
                spacing: Metrics.spacing;
                alignment: start;

                if root.profiles.length == 0: Text {
                    text: "No profiles found.";
                    color: Colors.text-dim;
                    font-size: Typography.body;
                }

                for profile in root.profiles: Card {
                    Text {
                        text: profile.name;
                        color: Colors.text;
                        font-size: Typography.heading;
                        font-weight: 600;
                    }

                    Text {
                        text: "id: " + profile.id;
                        color: Colors.text-dim;
                        font-size: Typography.small;
                    }

                    if profile.description != "": Text {
                        text: profile.description;
                        color: Colors.text-dim;
                        font-size: Typography.body;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
