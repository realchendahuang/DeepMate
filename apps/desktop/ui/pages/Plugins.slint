import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Card } from "../components/Card.slint";
import { Badge } from "../components/Badge.slint";
import { Colors } from "../theme/Colors.slint";
import { Metrics } from "../theme/Metrics.slint";
import { Typography } from "../theme/Typography.slint";

// One plugin row, mirrored from the core Plugin model.
export struct PluginRow {
    id: string,
    name: string,
    version: string,
    enabled: bool,
    profile: string,
    outdated: bool,
    latest: string,
}

// Plugins page: inventory plus install/remove/update, mirroring the CLI.
export component PluginsPage inherits Rectangle {
    in property <[PluginRow]> plugins: [];
    in property <bool> busy: false;

    callback refresh();
    callback install(string, string);
    callback remove(string, string);
    callback update(string, string);

    in-out property <string> install-profile: "web";
    in-out property <string> install-spec: "";

    background: Colors.bg;

    sv := ScrollView {
        VerticalLayout {
            width: sv.visible-width;
            padding: Metrics.padding;
            spacing: Metrics.spacing;
            alignment: start;

            HorizontalLayout {
                spacing: Metrics.spacing;

                Text {
                    text: "Plugins";
                    color: Colors.text;
                    font-size: Typography.title;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Refresh";
                    enabled: !root.busy;
                    clicked => {
                        root.refresh();
                    }
                }
            }

            Card {
                Text {
                    text: "Install";
                    color: Colors.text;
                    font-size: Typography.heading;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: Metrics.spacing;
                    alignment: start;

                    LineEdit {
                        text <=> root.install-profile;
                        placeholder-text: "profile";
                    }

                    LineEdit {
                        text <=> root.install-spec;
                        placeholder-text: "package name";
                    }

                    Button {
                        text: "Install";
                        enabled: !root.busy && root.install-spec != "";
                        clicked => {
                            root.install(root.install-profile, root.install-spec);
                        }
                    }
                }
            }

            if root.plugins.length == 0: Text {
                text: "No plugins found.";
                color: Colors.text-dim;
                font-size: Typography.body;
            }

            for plugin in root.plugins: Card {
                HorizontalLayout {
                    spacing: Metrics.spacing;
                    alignment: start;

                    Text {
                        text: plugin.name;
                        color: Colors.text;
                        font-size: Typography.heading;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Badge {
                        text: plugin.enabled ? "enabled" : "disabled";
                        kind: plugin.enabled ? "pass" : "neutral";
                    }

                    if plugin.outdated: Badge {
                        text: "outdated";
                        kind: "warn";
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Update";
                        enabled: !root.busy;
                        clicked => {
                            root.update(plugin.profile, plugin.id);
                        }
                    }

                    Button {
                        text: "Remove";
                        enabled: !root.busy;
                        clicked => {
                            root.remove(plugin.profile, plugin.id);
                        }
                    }
                }

                Text {
                    text: plugin.profile + "/" + plugin.id;
                    color: Colors.text-dim;
                    font-size: Typography.small;
                }

                if plugin.version != "": Text {
                    text: "v" + plugin.version + (plugin.outdated ? " (latest " + plugin.latest + ")" : "");
                    color: plugin.outdated ? Colors.warn : Colors.text-dim;
                    font-size: Typography.body;
                }
            }
        }
    }
}
