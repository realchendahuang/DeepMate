import { Button, ScrollView } from "std-widgets.slint";
import { Card } from "../components/Card.slint";
import { Colors } from "../theme/Colors.slint";
import { Metrics } from "../theme/Metrics.slint";
import { Typography } from "../theme/Typography.slint";

// One provider row, mirrored from the core Provider model.
export struct ProviderRow {
    id: string,
    name: string,
    kind: string,
}

// Providers page: list the configured providers.
export component ProvidersPage inherits Rectangle {
    in property <[ProviderRow]> providers: [];

    callback refresh();

    background: Colors.bg;

    VerticalLayout {
        padding: Metrics.padding;
        spacing: Metrics.spacing;

        HorizontalLayout {
            spacing: Metrics.spacing;

            Text {
                text: "Providers";
                color: Colors.text;
                font-size: Typography.title;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Refresh";
                clicked => {
                    root.refresh();
                }
            }
        }

        sv := ScrollView {
            VerticalLayout {
                width: sv.visible-width;
                spacing: Metrics.spacing;
                alignment: start;

                if root.providers.length == 0: Text {
                    text: "No providers configured.";
                    color: Colors.text-dim;
                    font-size: Typography.body;
                }

                for provider in root.providers: Card {
                    HorizontalLayout {
                        spacing: Metrics.spacing;
                        alignment: start;

                        Text {
                            text: provider.name;
                            color: Colors.text;
                            font-size: Typography.heading;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "(" + provider.kind + ")";
                            color: Colors.text-dim;
                            font-size: Typography.body;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "id: " + provider.id;
                        color: Colors.text-dim;
                        font-size: Typography.small;
                    }
                }
            }
        }
    }
}
